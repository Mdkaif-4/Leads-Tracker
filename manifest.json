{
  "manifest_version": 3,
  "name": "Lead Tracker",
  "version": "1.0",
  "description": "Save and manage leads from browser tabs",
  "permissions": [
    "tabs"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": "star-plus.png"
  },
   "star-plus.png": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}